   <div class="soc"><button aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 8V6.500c0-.7.200-1 1.200-1H17V2h-2.700C11.200 2 10 3.800 10 6.200V8H7.500v3.500H10V22h4V11.500h2.700L17 8z"/></svg></button><a href="https://facebook.com/qlink" target="_blank" rel="noopener">facebook.com/qlink</a></div>
