  <div class="card rv"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7a3 3 0 0 0 3 3v10M9 2v7M6 2v7M17 22V2c-2.500 1.500-4 4.500-4 8 0 2 1.500 3 4 3"/></svg></div><h3 data-i="sv4"></h3><p data-i="sv4p"></p></div>
 </div>
