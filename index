<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Q-Link</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#fff;--fg:#0a0a0a;--mut:#666;--line:#e3e3e3;--card:#f6f6f6;--inv:#0a0a0a;--invfg:#fff}
[data-theme=dark]{--bg:#000;--fg:#f4f4f4;--mut:#9a9a9a;--line:#232323;--card:#0d0d0d;--inv:#f4f4f4;--invfg:#000}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:68px;overflow-x:hidden;-webkit-text-size-adjust:100%}
body{font-family:'Tajawal','Segoe UI',Tahoma,Arial,sans-serif;font-weight:400;background:var(--bg);color:var(--fg);line-height:1.7;transition:background .4s,color .4s;overflow-x:clip}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--fg);outline-offset:3px}
.wrap{width:100%;max-width:1120px;margin:0 auto;padding:0 clamp(16px,4vw,32px)}
section{padding:96px 0}
h1,h2,h3{line-height:1.3;font-weight:800}
h1,h2,h3,p,li{overflow-wrap:break-word}
.grid>*,.about>*,.contact>*{min-width:0}
img,svg{max-width:100%}
h2{font-size:clamp(28px,4vw,42px);margin-bottom:12px}
.sub{color:var(--mut);max-width:560px;margin-bottom:48px}

/* logo */
.logo{direction:ltr;display:inline-flex;align-items:center;line-height:0;color:inherit}
.logo svg{display:block;height:100%;width:auto;overflow:visible}

/* loader */
#loader{position:fixed;inset:0;z-index:99;background:#000;color:#fff;display:grid;place-items:center;transition:opacity .8s ease,visibility .8s}
#loader.done{opacity:0;visibility:hidden}
#loader .logo{width:min(84vw,760px);height:auto}
#loader .logo svg{width:100%;height:auto}
/* part 1: Q starts centered, then slides left */
#loader .pq{transform:translateX(1082px);animation:fadeq .6s ease both;transition:transform 1.4s cubic-bezier(.65,0,.25,1)}
#loader.go .pq{transform:none}
@keyframes fadeq{from{opacity:0}to{opacity:1}}
/* part 2: chain is drawn left to right through a mask */
#loader .mk{stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1s ease-in-out .5s}
#loader.go .mk{stroke-dashoffset:0}
/* part 3: "Link" letters ease in after the chain */
#loader .l{opacity:0;transform:translateX(-100px);transition:opacity .6s ease var(--d),transform .8s cubic-bezier(.2,.7,.2,1) var(--d)}
#loader.go .l{opacity:1;transform:none}

/* nav */
header{position:fixed;top:0;inset-inline:0;z-index:50;background:var(--bg);border-bottom:1px solid var(--line)}
nav{display:flex;align-items:center;justify-content:space-between;height:60px;gap:16px}
nav .logo{height:28px}
.links{display:flex;gap:24px;font-size:14px;font-weight:500;color:var(--mut)}
.links a:hover{color:var(--fg)}
.tools{display:flex;gap:8px;align-items:center}
.ib{height:34px;min-width:34px;padding:0 10px;border-radius:99px;border:1px solid var(--line);background:none;color:var(--fg);cursor:pointer;font-family:inherit;font-size:12px;font-weight:500;display:grid;place-items:center;transition:.25s}
.ib:hover{background:var(--inv);color:var(--invfg);transform:translateY(-2px)}
.ib svg{width:16px;height:16px}
[data-theme=dark] .sun{display:block}[data-theme=dark] .moon{display:none}
.sun{display:none}
[data-theme=light] .moon{display:block}
.burger{display:none}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:10px;padding:15px 30px;border-radius:99px;background:var(--inv);color:var(--invfg);font-weight:700;border:1px solid var(--inv);cursor:pointer;font-family:inherit;font-size:16px;transition:transform .25s,box-shadow .25s,background .25s,color .25s}
.btn:hover{transform:translateY(-3px);box-shadow:0 12px 30px -10px var(--fg)}
.btn:active{transform:scale(.97)}
.btn.o{background:none;color:var(--fg);border-color:var(--line)}
.btn.o:hover{background:var(--inv);color:var(--invfg)}

/* hero */
.hero{min-height:100vh;display:flex;align-items:center;padding-top:120px;position:relative}
.hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:64px 64px;-webkit-mask-image:radial-gradient(ellipse at 50% 40%,#000 0,transparent 70%);mask-image:radial-gradient(ellipse at 50% 40%,#000 0,transparent 70%);opacity:.7}
.hero .wrap{position:relative}
.hero h1{font-size:clamp(38px,7vw,86px);max-width:900px;letter-spacing:-.02em;margin-bottom:24px}
.hero p{font-size:clamp(17px,2vw,21px);color:var(--mut);max-width:620px;margin-bottom:40px}
.cta{display:flex;gap:14px;flex-wrap:wrap}
.chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:56px}
.chip{border:1px solid var(--line);border-radius:99px;padding:6px 16px;font-size:14px;color:var(--mut)}

/* about */
.about>div{max-width:720px}
.about p{color:var(--mut);font-size:18px}

/* cards */
.grid{display:grid;gap:20px}
.g4{grid-template-columns:repeat(4,1fr)}.g3{grid-template-columns:repeat(3,1fr)}
.card{border:1px solid var(--line);background:var(--card);border-radius:22px;padding:30px;transition:transform .3s,border-color .3s}
.card:hover{transform:translateY(-6px);border-color:var(--fg)}
.card .ic{width:52px;height:52px;border-radius:14px;background:var(--inv);color:var(--invfg);display:grid;place-items:center;margin-bottom:22px;transition:transform .4s}
.card:hover .ic{transform:rotate(-8deg) scale(1.08)}
.ic svg{width:26px;height:26px}
.card h3{font-size:20px;margin-bottom:8px}.card p{color:var(--mut);font-size:15px}

/* portfolio */
.pf{padding:0;overflow:hidden}
.shot{height:200px;border-bottom:1px solid var(--line);display:grid;place-items:center;position:relative;overflow:hidden;background:repeating-linear-gradient(45deg,var(--card),var(--card) 12px,var(--bg) 12px,var(--bg) 24px)}
.mock{width:62%;height:74%;border:1px solid var(--fg);border-radius:12px 12px 0 0;background:var(--bg);align-self:end;padding:12px;display:grid;gap:7px;align-content:start;transition:transform .4s}
.pf:hover .mock{transform:translateY(-10px)}
.mock i{display:block;height:8px;border-radius:4px;background:var(--line)}.mock i:first-child{width:40%;background:var(--fg)}.mock i:nth-child(3){width:70%}
.pf .in{padding:24px;display:flex;justify-content:space-between;align-items:center;gap:12px}
.pf h3{font-size:18px}.pf small{color:var(--mut)}
.pv{font-size:14px;font-weight:700;border-bottom:1px solid var(--fg);white-space:nowrap}

/* pricing */
.setup{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;border:1px dashed var(--fg);border-radius:20px;padding:20px 28px;margin-bottom:24px}
.setup b{font-size:28px}
.price{display:flex;flex-direction:column;position:relative}
.price.hot{background:var(--inv);color:var(--invfg);border-color:var(--inv)}
.price.hot p,.price.hot .per{color:inherit;opacity:.7}
.price .amt{font-size:48px;font-weight:700;line-height:1.1;margin:14px 0 4px;direction:ltr;text-align:start}
.price .was{font-size:18px;text-decoration:line-through;opacity:.5;font-weight:400;margin-inline-start:8px}
.per{color:var(--mut);font-size:14px;margin-bottom:22px}
.price ul{list-style:none;margin-bottom:28px;flex:1;font-size:15px}
.price li{padding:7px 0;border-top:1px solid var(--line);display:flex;gap:10px}
.price.hot li{border-color:#8884}
.price li::before{content:"✓";font-weight:700}
.price .btn{justify-content:center}
.price.hot .btn{background:var(--invfg);color:var(--inv);border-color:var(--invfg)}
.tag{position:absolute;top:18px;inset-inline-end:18px;font-size:12px;padding:3px 12px;border-radius:99px;background:var(--invfg);color:var(--inv);font-weight:700}

/* testimonials */
.q{font-size:17px;margin-bottom:22px}
.who{display:flex;gap:12px;align-items:center}
.av{width:42px;height:42px;border-radius:50%;background:var(--inv);color:var(--invfg);display:grid;place-items:center;font-weight:700}
.who small{display:block;color:var(--mut)}

/* contact */
.socials{display:flex;flex-direction:column;gap:14px;align-items:flex-start}
.soc{max-width:100%;display:inline-flex;align-items:center;height:64px;border:1px solid var(--line);background:var(--card);border-radius:99px;overflow:hidden;transition:background .3s,color .3s,border-color .3s}
.soc button{width:64px;height:64px;flex:none;border:0;background:none;color:inherit;cursor:pointer;display:grid;place-items:center}
.soc svg{width:26px;height:26px}
.soc a{max-width:0;opacity:0;white-space:nowrap;direction:ltr;font-weight:500;padding-inline-end:0;transition:max-width .5s cubic-bezier(.6,0,.2,1),opacity .4s,padding .5s}
.soc:hover,.soc:focus-within,.soc.open{background:var(--inv);color:var(--invfg);border-color:var(--inv)}
.soc:hover a,.soc:focus-within a,.soc.open a{max-width:min(300px,calc(100vw - 150px));opacity:1;padding-inline-end:28px}
.contact{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
form{display:grid;gap:14px}
input,textarea{width:100%;padding:15px 18px;border-radius:14px;border:1px solid var(--line);background:var(--card);color:var(--fg);font:inherit}
input:focus,textarea:focus{outline:none;border-color:var(--fg)}
textarea{min-height:120px;resize:vertical}
.note{color:var(--mut);font-size:14px}

footer{border-top:1px solid var(--line);padding:32px 0;color:var(--mut);font-size:14px}
footer .wrap{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
footer .logo{height:24px;color:var(--fg)}

.rv{opacity:0;transform:translateY(28px);transition:opacity .8s ease,transform .8s ease}
.rv.in{opacity:1;transform:none}

@media(min-width:1600px){.wrap{max-width:1360px}section{padding:120px 0}.hero h1{max-width:1100px}}
@media(min-width:2200px){.wrap{max-width:1600px}.hero p{max-width:760px}}
@media(max-width:1100px){.g4{grid-template-columns:1fr 1fr}}
@media(max-width:960px){.g3{grid-template-columns:1fr 1fr}.about,.contact{grid-template-columns:1fr;gap:40px}}
@media(max-width:760px){
 section{padding:72px 0}
 .burger{display:grid}
 .links{position:fixed;top:60px;inset-inline:0;background:var(--bg);flex-direction:column;padding:20px 24px;gap:18px;border-bottom:1px solid var(--line);transform:translateY(-130%);transition:transform .4s;z-index:-1}
 .links.open{transform:none}
 .g4,.g3{grid-template-columns:1fr}
 .card{padding:24px}
}
@media(max-width:480px){.cta .btn{width:100%;justify-content:center}.setup{padding:18px}.pf .in{flex-wrap:wrap}.chips{margin-top:36px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition-duration:.01ms!important}.rv{opacity:1;transform:none}}
</style>
</head>
<body>

<div id="loader" aria-hidden="true">
  <div class="logo"></div>
</div>

<header>
 <div class="wrap"><nav>
  <a href="#home" class="logo" aria-label="Q-Link"></a>
  <div class="links" id="links">
