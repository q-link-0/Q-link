<footer><div class="wrap"><a href="#home" class="logo"></a><span data-i="foot"></span></div></footer>

<script>
/* ===== Settings: change the number (digits only, with country code) ===== */
const WA_NUMBER = "201000000000";

const T = {
ar:{n_about:"من نحن",n_services:"خدماتنا",n_work:"أعمالنا",n_pricing:"الأسعار",n_contact:"تواصل",
h_title:"موقعك، هويتك، واستضافتك في مكان واحد.",
