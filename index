  <div class="card rv"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7zM18 13l-1.5-7.5L2 2l3.5 14.500L13 18zM2 2l7.600 7.600"/><circle cx="11" cy="11" r="2"/></svg></div><h3 data-i="sv2"></h3><p data-i="sv2p"></p></div>
